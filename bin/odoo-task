#!/usr/bin/env bash
# Entry point: finds its own folder (through symlinks) and runs the Python package. Nothing else.
set -euo pipefail
ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
command -v python3 >/dev/null 2>&1 || { echo "odoo-task: python3 is required (3.9 or later)" >&2; exit 1; }
python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' \
    || { echo "odoo-task: Python 3.9 or later is required" >&2; exit 1; }
export ODOO_TASK_ROOT="$ROOT"
PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m odoo_task "$@"
